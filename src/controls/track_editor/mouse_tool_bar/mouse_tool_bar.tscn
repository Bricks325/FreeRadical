[node name="SelectItemModeButton" type="Button" parent="." unique_id=1903254406]
layout_mode = 2
tooltip_text = "选择模式。
左键：选择项。
左键+拖拽：移动选中项。
Shift+左键+拖拽：移动选中项并吸附到最近刻度。
右键：增加项。
Ctrl+右键：删除项。"
